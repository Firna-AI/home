---
// The document of each page: the head, the shared stylesheet, the body, and
// the grain field, the page's only client script. Each page passes its own
// title. A page with an address of its own also passes its description and
// its canonical address. The not-found page passes neither, because its
// address has no page.
import "../styles/site.css";

interface Props {
  /** The title of the page. It names the page. */
  readonly title: string;
  /** The description of the page for search results. */
  readonly description?: string;
  /** The canonical address of the page. */
  readonly canonical?: URL;
}

const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    {description !== undefined && (
      <meta name="description" content={description} />
    )}
    {canonical !== undefined && <link rel="canonical" href={canonical} />}
    {/* The ICO is for browsers that read no SVG favicon. With its sizes, the
         other browsers still pick the SVG and its dark-theme mark. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
    <script>
      // The grain field: the page's only client script.
      import "../field/main";
    </script>
  </body>
</html>
