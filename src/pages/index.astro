---
import { company } from "../company";
import { Homepage } from "../components/Homepage";
import Page from "../layouts/Page.astro";
import { projects } from "../projects";

// The description names the projects from the list, so that a new project
// changes it. Like the title, it makes no statement about Firna.
const projectNames = new Intl.ListFormat("en", { type: "conjunction" }).format(
  projects.map((project) => project.name),
);
const description = `Firna's projects: ${projectNames}.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<Page title="Firna" description={description} canonical={canonical}>
  <Homepage company={company} projects={projects} />
</Page>
