{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true
  },
  "files": [
    "node_modules/@types/react/index.d.ts",
    "node_modules/@types/react-dom/index.d.ts"
  ],
  "include": ["src/**/*", "docs/mockups/**/*"]
}
